Config { overrideRedirect = True
       , font        = "xft:iosevka-9"
       , bgColor     = "#5f5f5f"
       , fgColor     = "#f8f8f2"
       , position    = TopW L 100
       , lowerOnStart = True
       , persistent = False
       , commands = [ Run Cpu
                        [ "-L", "3"
                        , "-H", "50"
                        , "--high"  , "red"
                        , "--normal", "green"
                        ] 15
                    , Run Memory ["--template", "Mem: <usedratio>%"] 20
                    , Run Swap [] 30
                    , Run Battery
                             [ "--template" , "<acstatus>"
                             , "--Low"      , "10"        -- units: %
                             , "--High"     , "80"        -- units: %
                             , "--low"      , "darkred"
                             , "--normal"   , "darkorange"
                             , "--high"     , "darkgreen"
                             , "--" -- battery specific options
                                       -- discharging status
                                       , "-o"	, "<fc=#c2a00c>⚡↓</fc><left><fc=#f8f8f2>%</fc>"
                                       -- AC "on" status
                                       , "-O"	, "<fc=#c2a00c>⚡↑</fc><left><fc=#f8f8f2>%</fc>"
                                       -- charged status
                                       , "-i"	, "<fc=#c2a00c>⚡</fc><fc=#006000>Full</fc>"
                                       , "-a"   , "dunstify -u critical 'Battery' 'Battery running out!'"
                             ] 20
                    , Run Date "%a %Y-%m-%d <fc=#8be9fd>%H:%M</fc>" "date" 10
                    , Run XMonadLog
                    , Run XPropertyLog "_XMONAD_TRAYPAD"
                    ]
       , sepChar  = "%"
       , alignSep = "}{"
       , template = "%XMonadLog% }{ %cpu% | %battery% | %memory% * %swap% | %date% | %_XMONAD_TRAYPAD%"
       }
